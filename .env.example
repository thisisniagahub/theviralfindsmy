# ═══════════════════════════════════════════════════════════════
# TheViralFinds — Environment Variables
# ═══════════════════════════════════════════════════════════════
# For Vercel: Create a Vercel Postgres database in the dashboard.
# Vercel will auto-set DATABASE_URL and POSTGRES_URL.
# ═══════════════════════════════════════════════════════════════

# Database — PostgreSQL (required)
# Vercel Postgres (Neon) format:
# DATABASE_URL=postgresql://username:password@host.neon.tech/neondb?sslmode=require
# Or Vercel auto-sets this when you create a Postgres store
DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/theviralfinds

# NextAuth
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# Admin
ADMIN_EMAIL=admin@theviralfinds.my
# Local dev preview: if DEMO_MODE=true, leaving the placeholder below will fall back to admin123 in the auth route.
# Set ADMIN_PASSWORD=admin123 explicitly if you want the env file to mirror the preview credentials shown in the UI.
# Production: use a strong bcrypt hash instead of plaintext
ADMIN_PASSWORD=your-admin-password

# Demo Mode (set to false in production)
DEMO_MODE=true

# Skip Auth for development
SKIP_AUTH=false

# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=https://operator.gangniaga.my
OPENCLAW_GATEWAY_PROXY_URL=https://api.gangniaga.my/openclaw
OPENCLAW_GATEWAY_TOKEN=your-gateway-token
OPENCLAW_WEBHOOK_SECRET=your-webhook-secret
OPENCLAW_WS_ENABLED=true
OPENCLAW_HOOKS_PATH=/hooks
# Browser-facing OpenClaw flags (optional)
NEXT_PUBLIC_OPENCLAW_GATEWAY_URL=https://operator.gangniaga.my
NEXT_PUBLIC_OPENCLAW_WS_ENABLED=false

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Twilio (optional)
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Notification Service
# Local development: keep localhost when Next.js and the mini-service run on the same machine.
# Production/Vercel: point this to an externally reachable proxy URL on the VPS.
# Example production value: https://api.gangniaga.my/notification
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3004
# Browser-facing notification socket URL (optional)
# Example: https://shopee.gangniaga.my/?XTransformPort=3004
NEXT_PUBLIC_NOTIFICATION_URL=

# DB Microservice
# Local development: keep localhost when Next.js and the DB service run on the same machine.
# Production/Vercel: point this to an externally reachable proxy URL on the VPS.
# Example production value: https://api.gangniaga.my/db
DB_SERVICE_URL=http://127.0.0.1:3005
# Required outside local DEMO_MODE preview: generate with openssl rand -base64 32
DB_SERVICE_SECRET=your-generated-secret-here

# ═══════════════════════════════════════════════════════════════
# Shopee Seller API (REST — via @congminh1254/shopee-sdk)
# Register at: https://open.shopee.com
# ═══════════════════════════════════════════════════════════════
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_REGION=MY
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
SHOPEE_USE_SANDBOX=true

# ═══════════════════════════════════════════════════════════════
# Shopee Affiliate API (GraphQL)
# Register at: https://affiliate.shopee.com.my/open_api/home
# ═══════════════════════════════════════════════════════════════
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

# ═══════════════════════════════════════════════════════════════
# Upstash Redis (optional - for distributed cache & rate limiting)
# Create at: https://upstash.com
# ═══════════════════════════════════════════════════════════════
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Asset CDN (optional — for serving game assets from CDN)
# Cloudflare R2: https://pub-<account-id>.r2.dev
# BunnyCDN: https://<zone>.b-cdn.net
CDN_BASE_URL=

# Database - Use PostgreSQL for production/Vercel
DATABASE_URL=file:./dev.db

# NextAuth
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Admin
ADMIN_PASSWORD=your-admin-password

# Demo Mode (set to false in production)
DEMO_MODE=true

# Skip Auth for development
SKIP_AUTH=true

# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=https://your-gateway-url.com
OPENCLAW_GATEWAY_TOKEN=your-gateway-token

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Twilio (optional)
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Notification Service (local dev only)
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3004

# DB Microservice (local dev only - bypasses Turbopack+Prisma hang)
DB_SERVICE_URL=http://127.0.0.1:3005

# Shopee API (optional)
SHOPEE_API_KEY=your-shopee-api-key

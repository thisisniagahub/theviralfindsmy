:81 {
	# Only allow reverse proxy to known, whitelisted local service ports.
	# The previous XTransformPort=* matcher allowed ARBITRARY port access,
	# enabling any external caller to reach internal services (DB service,
	# notification service, etc.) without authentication.

	@port_3004 {
		query XTransformPort=3004
	}
	handle @port_3004 {
		reverse_proxy localhost:3004 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}

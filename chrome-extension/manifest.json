{
  "manifest_version": 3,
  "name": "TheViralFinds — Shopee Affiliate Link Generator",
  "version": "1.0.0",
  "description": "Quick affiliate link creation from any Shopee product page. One-click link generation with tracking.",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://shopee.com.my/*",
    "https://theviralfinds.my/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://shopee.com.my/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

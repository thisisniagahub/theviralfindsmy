generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Models ─────────────────────────────────────────────────────

model AffiliateLink {
  id                String        @id @default(cuid())
  name              String
  productUrl        String
  affiliateUrl      String
  productId         String?
  productName       String?
  productImage      String?
  productPrice      Float?
  commission        Float?
  category          String?
  campaignId        String?
  clicks            Int           @default(0)
  conversions       Int           @default(0)
  earnings          Float         @default(0)
  status            String        @default("active")
  shortCode         String        @unique
  expiresAt         DateTime?
  campaign          Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  clickRecords      ClickRecord[]
  conversionRecords Conversion[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([campaignId])
  @@index([category])
  @@index([createdAt])
  @@map("affiliate_links")
}

model Campaign {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      String          @default("active")
  budget      Float?
  spent       Float           @default(0)
  startDate   DateTime?
  endDate     DateTime?
  links       AffiliateLink[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@map("campaigns")
}

model ClickRecord {
  id            String        @id @default(cuid())
  linkId        String
  affiliateLink AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  ip            String?
  country       String?
  referer       String?
  device        String?
  converted     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([linkId])
  @@index([createdAt])
  @@index([device])
  @@map("click_records")
}

model Conversion {
  id            String        @id @default(cuid())
  linkId        String
  affiliateLink AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  orderId       String?
  amount        Float
  commission    Float
  status        String        @default("pending")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([linkId])
  @@index([status])
  @@index([createdAt])
  @@map("conversions")
}

model Payout {
  id          String   @id @default(cuid())
  method      String   @default("bank_transfer")
  amount      Float
  status      String   @default("pending")
  bankName    String?
  accountNo   String?
  accountName String?
  requestedAt DateTime @default(now())
  processedAt DateTime?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([requestedAt])
  @@map("payouts")
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model EarningGoal {
  id            String   @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  period        String   @default("monthly")
  startDate     DateTime @default(now())
  endDate       DateTime?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([period])
  @@map("earning_goals")
}

model Notification {
  id          String   @id @default(cuid())
  type        String   @default("system")
  title       String
  description String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([read])
  @@index([createdAt])
  @@index([type])
  @@map("notifications")
}

model AgentMemory {
  id        String   @id @default(cuid())
  agentId   String
  sessionId String?
  role      String
  content   String
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("agent_memories")
}

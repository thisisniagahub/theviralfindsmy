generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────

enum LinkStatus {
  active
  paused
  expired
}

enum CampaignStatus {
  active
  paused
  completed
}

enum ConversionStatus {
  pending
  confirmed
  rejected
  paid
}

enum PayoutStatus {
  pending
  processing
  completed
  failed
}

enum GoalStatus {
  active
  achieved
  failed
}

enum GoalPeriod {
  monthly
  weekly
  yearly
  custom
}

enum UserRole {
  admin
  affiliate
  viewer
}

// ─── Models ─────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          UserRole @default(affiliate)
  avatarUrl     String?
  shopeeAffId   String?
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  links         AffiliateLink[]
  clickRecords  ClickRecord[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model AffiliateLink {
  id                String        @id @default(cuid())
  name              String
  productUrl        String
  affiliateUrl      String
  productId         String?
  productName       String?
  productImage      String?
  productPrice      Decimal?      @db.Decimal(10,2)
  commission        Decimal?      @db.Decimal(10,2)
  category          String?
  campaignId        String?
  userId            String?
  clicks            Int           @default(0)
  conversions       Int           @default(0)
  earnings          Decimal       @default(0) @db.Decimal(12,2)
  status            LinkStatus    @default(active)
  shortCode         String        @unique
  expiresAt         DateTime?
  campaign          Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  clickRecords      ClickRecord[]
  conversionRecords Conversion[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([campaignId])
  @@index([category])
  @@index([createdAt])
  @@index([productId])
  @@index([userId])
  @@map("affiliate_links")
}

model Campaign {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      CampaignStatus  @default(active)
  budget      Decimal?        @db.Decimal(12,2)
  spent       Decimal         @default(0) @db.Decimal(12,2)
  startDate   DateTime?
  endDate     DateTime?
  links       AffiliateLink[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@map("campaigns")
}

model ClickRecord {
  id            String        @id @default(cuid())
  linkId        String
  userId        String?
  affiliateLink AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  ip            String?
  country       String?
  referer       String?
  device        String?
  converted     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([linkId])
  @@index([createdAt])
  @@index([device])
  @@index([converted])
  @@index([userId])
  @@map("click_records")
}

model Conversion {
  id            String          @id @default(cuid())
  linkId        String
  affiliateLink AffiliateLink   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  orderId       String?
  amount        Decimal         @db.Decimal(12,2)
  commission    Decimal         @db.Decimal(12,2)
  status        ConversionStatus @default(pending)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([linkId])
  @@index([status])
  @@index([createdAt])
  @@map("conversions")
}

model Payout {
  id          String       @id @default(cuid())
  method      String       @default("bank_transfer")
  amount      Decimal      @db.Decimal(12,2)
  status      PayoutStatus @default(pending)
  bankName    String?
  accountNo   String?
  accountName String?
  requestedAt DateTime     @default(now())
  processedAt DateTime?
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([requestedAt])
  @@map("payouts")
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model EarningGoal {
  id            String     @id @default(cuid())
  name          String
  targetAmount  Decimal    @db.Decimal(12,2)
  currentAmount Decimal    @default(0) @db.Decimal(12,2)
  period        GoalPeriod @default(monthly)
  startDate     DateTime   @default(now())
  endDate       DateTime?
  status        GoalStatus @default(active)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([period])
  @@map("earning_goals")
}

model Notification {
  id          String   @id @default(cuid())
  type        String   @default("system")
  title       String
  description String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([read])
  @@index([createdAt])
  @@index([type])
  @@map("notifications")
}

model AgentMemory {
  id        String   @id @default(cuid())
  agentId   String
  sessionId String?
  role      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("agent_memories")
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String?
  type        String   // e.g., "first_sale", "100_clicks", "top_earner"
  title       String
  description String
  icon        String   // icon name
  earnedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([earnedAt])
  @@map("achievements")
}

model LeaderboardEntry {
  id               String   @id @default(cuid())
  userId           String?
  userName         String
  totalEarnings    Decimal  @default(0) @db.Decimal(12,2)
  totalClicks      Int      @default(0)
  totalConversions Int      @default(0)
  period           String   // "weekly", "monthly", "yearly"
  rank             Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([period])
  @@index([rank])
  @@unique([userId, period])
  @@map("leaderboard_entries")
}

model Referral {
  id           String    @id @default(cuid())
  referrerId   String?
  referredEmail String
  referredName  String?
  status       String    @default("pending") // pending, registered, active
  commission   Decimal?  @db.Decimal(12,2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([referrerId])
  @@index([status])
  @@map("referrals")
}

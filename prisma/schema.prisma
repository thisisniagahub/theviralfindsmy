generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Multi-merchant support
enum Merchant {
  SHOPEE
  LAZADA
  TIKTOK_SHOP
  AMAZON
}

enum Role {
  USER
  ADMIN
}

enum LinkStatus {
  active
  paused
  expired
}

enum CampaignStatus {
  active
  paused
  completed
}

enum PayoutStatus {
  pending
  processing
  completed
  failed
}

enum GoalStatus {
  active
  completed
  cancelled
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String?
  passwordHash    String?
  image           String?
  role            Role              @default(USER)
  affiliateLinks  AffiliateLink[]
  campaigns       Campaign[]
  payouts         Payout[]
  appSettings     AppSetting[]
  earningGoals    EarningGoal[]
  notifications   Notification[]
  agentMemories   AgentMemory[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model AffiliateLink {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  merchant          Merchant      @default(SHOPEE)
  productUrl        String
  affiliateUrl      String
  productId         String?
  productName       String?
  productImage      String?
  productPrice      Decimal?        @db.Decimal(10, 2)
  commission        Decimal?        @db.Decimal(10, 2)
  category          String?
  campaignId        String?
  clicks            Int             @default(0)
  conversions       Int             @default(0)
  earnings          Decimal         @default(0) @db.Decimal(10, 2)
  status            LinkStatus      @default(active)
  shortCode         String        @unique
  expiresAt         DateTime?
  campaign          Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  clickRecords      ClickRecord[]
  conversionRecords Conversion[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([campaignId])
  @@index([category])
}

model Campaign {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      CampaignStatus  @default(active)
  budget      Decimal?        @db.Decimal(10, 2)
  spent       Decimal         @default(0) @db.Decimal(10, 2)
  startDate   DateTime?
  endDate     DateTime?
  links       AffiliateLink[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
}

model ClickRecord {
  id            String        @id @default(cuid())
  linkId        String
  affiliateLink AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  ip            String?
  country       String?
  referer       String?
  device        String?
  converted     Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@index([linkId, createdAt])
  @@index([device])
}

model Conversion {
  id            String        @id @default(cuid())
  linkId        String
  affiliateLink AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  orderId       String?
  amount        Decimal         @db.Decimal(10, 2)
  commission    Decimal         @db.Decimal(10, 2)
  status        String          @default("pending") // pending, confirmed, rejected, paid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([linkId, status, createdAt])
}

model Payout {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  method      String        @default("bank_transfer")
  amount      Decimal       @db.Decimal(10, 2)
  status      PayoutStatus  @default(pending)
  bankName    String?
  accountNo   String?
  accountName String?
  requestedAt DateTime  @default(now())
  processedAt DateTime?
  note        String?

  @@index([status])
  @@index([requestedAt])
  @@index([userId])
}

model AppSetting {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

model EarningGoal {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Decimal     @db.Decimal(10, 2)
  currentAmount Decimal     @default(0) @db.Decimal(10, 2)
  period        String
  startDate     DateTime  @default(now())
  endDate       DateTime?
  status        GoalStatus  @default(active)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, status])
  @@index([period])
  @@index([userId])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @default("system")
  title       String
  description String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
  @@index([type])
}

model AgentMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String
  sessionId String?
  role      String // 'user' | 'assistant' | 'system'
  content   String  @db.VarChar(10000)
  metadata  String? // JSON string for extra data
  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([userId])
}
